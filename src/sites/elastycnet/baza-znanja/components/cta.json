        "type": "string",
        "maxLength": 300,
        "title": "Naslov"
      },
      "title-second": {
        "type": "string",
        "maxLength": 300,
        "title": "Drugi red naslova"
      },
      "lead": {
        "type": "string",
        "maxLength": 300,
        "title": "Uvodni tekst"
      },
      "lead-second": {
        "type": "string",
        "maxLength": 300,
        "title": "Dopunski tekst"
      }
    }
  },
  "providerKey": null,
  "cache": {
    "scope": "public",
    "ttlSeconds": 900,
    "varyBy": [
      "tenant",
      "locale",
      "release"
    ]
  },
