        "maxLength": 300,
        "title": "Uvodni tekst"
      },
      "brand-name": {
        "type": "string",
        "title": "Naziv brenda",
        "maxLength": 100
      }
    }
  },
  "providerKey": null,
  "cache": {
    "scope": "public",
    "ttlSeconds": 900,
    "varyBy": [
      "tenant",
      "locale",
