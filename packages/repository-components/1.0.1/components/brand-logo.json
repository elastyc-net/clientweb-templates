{
  "formatVersion": 2,
  "contractVersion": 1,
  "componentKey": "brand-logo",
  "label": "Logo i naziv brenda",
  "category": "navigation",
  "renderMode": "static",
  "targets": [
    "web",
    "mobile"
  ],
  "htmlContent": "<a class=\"wf-brand-link wf:transition-colors wf:duration-200\" href=\"{{setting:home-url}}\" aria-label=\"{{setting:brand-name}} — početna\"><img class=\"wf-brand-logo\" src=\"{{setting:logo-url}}\" alt=\"{{setting:logo-alt}}\" width=\"136\" height=\"40\"><span class=\"wf-brand-name\">{{setting:brand-name}}</span></a>",
  "styles": [
    {
      "name": "brand-logo.css",
      "content": ".wf-brand-link{display:inline-flex;align-items:center;gap:calc(var(--wf-space-unit)*3);min-height:44px;border-radius:var(--wf-radius);color:var(--wf-color-text);font-family:var(--wf-font-heading);text-decoration:none}.wf-brand-link:hover,.wf-brand-link:focus-visible{color:var(--wf-color-primary);outline:none}.wf-brand-logo{display:block;width:auto;max-width:136px;height:40px;object-fit:contain}.wf-brand-name{font-size:1rem;font-weight:var(--wf-heading-weight);letter-spacing:-.02em;white-space:nowrap}@media(max-width:520px){.wf-brand-logo{max-width:108px;height:34px}.wf-brand-name{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}}.wf-brand-logo[src=\"\"]{display:none}.wf-brand-link[data-logo-missing=\"true\"] .wf-brand-name{position:static;width:auto;height:auto;overflow:visible;clip-path:none}"
    }
  ],
  "scripts": [
    {
      "name": "brand-logo.js",
      "content": "document.querySelectorAll('.wf-brand-link').forEach(function(root){if(root.dataset.logoReady)return;root.dataset.logoReady='true';var img=root.querySelector('img');function sync(){if(!img||!img.getAttribute('src')||img.complete&&!img.naturalWidth)root.dataset.logoMissing='true';else delete root.dataset.logoMissing;}if(img){img.addEventListener('error',function(){img.style.display='none';sync();});img.addEventListener('load',sync);}sync();});"
    }
  ],
  "settingsSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "brand-name",
      "logo-url",
      "logo-alt",
      "home-url"
    ],
    "properties": {
      "brand-name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "logo-url": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2048
      },
      "logo-alt": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "home-url": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "themeBindings": {
    "brand-name": "brand.name",
    "logo-url": "brand.logoUrl",
    "logo-alt": "brand.logoAlt"
  },
  "providerKey": null,
  "cache": {
    "scope": "public",
    "ttlSeconds": 3600,
    "varyBy": [
      "tenant",
      "locale",
      "release"
    ]
  },
  "access": {
    "visibility": "public",
    "permissions": []
  },
  "seo": {
    "mode": "none"
  }
}
