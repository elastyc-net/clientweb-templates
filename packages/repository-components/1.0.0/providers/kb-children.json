{
  "formatVersion": 2,
  "contractVersion": 1,
  "providerKey": "kb-children",
  "label": "Podređene strane baze znanja",
  "kind": "query",
  "dataScope": "tenant",
  "handler": "kb.children",
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
      "frontpage": {"type": "string", "maxLength": 40},
      "q": {"type": "string", "maxLength": 80}
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["found", "title", "html", "kind", "intro", "children"],
    "properties": {
      "found": {"type": "boolean"},
      "title": {"type": "string", "maxLength": 200},
      "html": {"type": "string", "maxLength": 100000},
      "kind": {"type": "string", "maxLength": 16, "enum": ["article", "folder"]},
      "intro": {"type": "string", "maxLength": 2000},
      "children": {"type": "array", "maxItems": 80, "items": {"type": "object", "additionalProperties": false, "required": ["title", "slug"], "properties": {"title": {"type": "string", "maxLength": 200}, "slug": {"type": "string", "maxLength": 200}, "route": {"type": "string", "maxLength": 200}, "description": {"type": "string", "maxLength": 160}, "image": {"type": "string", "maxLength": 2048}}}}
    }
  },
  "timeoutMs": 2500,
  "endpoint": {"exposure": "browser", "method": "GET", "authentication": "optional", "csrf": false}
}
